{
  "name": "pendel-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build:client && npx wrangler@4.107.0 pages dev dist",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "build": "npm run typecheck && npm run build:client",
    "test:api": "tsx --test tests/*.test.ts",
    "test:client": "tsx --tsconfig tsconfig.client.json --test \"client/src/**/*.test.ts\"",
    "test": "npm run test:api && npm run test:client",
    "check": "npm run build && npm test",
    "deploy:preview": "npm run build && npx wrangler@4.107.0 pages deploy dist --project-name pendel-pilot --branch preview",
    "deploy:production": "npm run build && npx wrangler@4.107.0 pages deploy dist --project-name pendel-pilot --branch main",
    "deploy:cloudflare-pages": "npx wrangler@4.107.0 pages deploy dist --project-name ${CLOUDFLARE_PAGES_PROJECT_NAME:-pendel-pilot} --branch ${CF_PAGES_BRANCH:-main}"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
